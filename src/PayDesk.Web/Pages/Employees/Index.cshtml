@page
@model PayDesk.Web.Pages.Employees.IndexModel
@{
    ViewData["Title"] = "Employees";
}

<h1>Employees</h1>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (Model.SuccessMessage is not null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<div class="card">
    <h2 style="margin-top:0;font-size:1.1rem;">Add employee</h2>
    <form method="post">
        <div class="form-group">
            <label asp-for="Input.EmployeeCode">Employee code</label>
            <input asp-for="Input.EmployeeCode" />
        </div>
        <div class="form-group">
            <label asp-for="Input.FullName">Full name</label>
            <input asp-for="Input.FullName" />
        </div>
        <div class="form-group">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" type="email" />
        </div>
        <div class="form-group">
            <label asp-for="Input.Password">Temporary password</label>
            <input asp-for="Input.Password" type="password" />
        </div>
        <div class="form-group">
            <label asp-for="Input.Role">Role</label>
            <select asp-for="Input.Role">
                <option value="Employee">Employee</option>
                <option value="Manager">Manager</option>
                <option value="Admin">Admin</option>
            </select>
        </div>
        <div class="form-group">
            <label asp-for="Input.Department">Department</label>
            <input asp-for="Input.Department" />
        </div>
        <div class="form-group">
            <label asp-for="Input.HourlyRate">Hourly rate</label>
            <input asp-for="Input.HourlyRate" type="number" step="0.01" min="0" />
        </div>
        <div class="form-group">
            <label asp-for="Input.ManagerId">Manager ID (optional)</label>
            <input asp-for="Input.ManagerId" type="number" />
        </div>
        <div class="form-group">
            <label asp-for="Input.HireDate">Hire date</label>
            <input asp-for="Input.HireDate" type="date" />
        </div>
        <button type="submit" class="btn">Add employee</button>
    </form>
</div>

<div class="card">
    <table>
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Role</th>
                <th>Department</th>
                <th>Rate</th>
                <th>Manager</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model.Employees)
            {
                <tr>
                    <td>@employee.EmployeeCode</td>
                    <td>@employee.FullName</td>
                    <td>@employee.Role</td>
                    <td>@employee.Department</td>
                    <td>@employee.HourlyRate.ToString("C")</td>
                    <td>@employee.ManagerName</td>
                    <td>@(employee.IsActive ? "Yes" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
