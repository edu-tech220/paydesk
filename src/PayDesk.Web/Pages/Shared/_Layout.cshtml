<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PayDesk</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <a class="navbar-brand" asp-area="" asp-page="/Index">PayDesk</a>
            <ul class="navbar-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li><a asp-page="/Timesheets/Index">Timesheets</a></li>
                    @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                    {
                        <li><a asp-page="/Approvals/Index">Approvals</a></li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a asp-page="/PayPeriods/Index">Pay Periods</a></li>
                        <li><a asp-page="/Employees/Index">Employees</a></li>
                    }
                    <li><a asp-page="/Payslips/Index">Payslips</a></li>
                    <li>
                        <form method="post" asp-page="/Logout" style="display:inline;">
                            <button type="submit" class="btn btn-secondary" style="padding:0.2rem 0.7rem;">
                                Sign out (@User.Identity!.Name)
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li><a asp-page="/Login">Sign in</a></li>
                }
            </ul>
        </nav>
    </header>
    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        &copy; 2026 - PayDesk
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
