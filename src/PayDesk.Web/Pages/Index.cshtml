@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="card">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <h1 style="margin-top:0;">Welcome back, @User.Identity!.Name</h1>
        <p class="text-muted">Signed in as <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong>.</p>
        <ul>
            <li><a asp-page="/Timesheets/Index">Log or review your hours</a></li>
            @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
            {
                <li><a asp-page="/Approvals/Index">Approve pending timesheet entries</a></li>
            }
            @if (User.IsInRole("Admin"))
            {
                <li><a asp-page="/PayPeriods/Index">Open, close and process pay periods</a></li>
                <li><a asp-page="/Employees/Index">Manage the employee roster</a></li>
            }
            <li><a asp-page="/Payslips/Index">View payslips</a></li>
        </ul>
    }
    else
    {
        <h1 style="margin-top:0;">PayDesk</h1>
        <p class="text-muted">A small payroll platform: timesheets, manager approvals, overtime and progressive tax
            rules, and payslip generation.</p>
        <a class="btn" asp-page="/Login">Sign in</a>
    }
</div>
