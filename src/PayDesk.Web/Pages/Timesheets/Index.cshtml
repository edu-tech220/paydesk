@page
@model PayDesk.Web.Pages.Timesheets.IndexModel
@{
    ViewData["Title"] = "Timesheets";
}

<h1>My timesheet</h1>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (Model.SuccessMessage is not null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<div class="card">
    <h2 style="margin-top:0;font-size:1.1rem;">Log hours</h2>
    @if (!Model.OpenPayPeriods.Any())
    {
        <p class="text-muted">There is no open pay period to log hours against right now.</p>
    }
    else
    {
        <form method="post">
            <div class="form-group">
                <label asp-for="Input.PayPeriodId">Pay period</label>
                <select asp-for="Input.PayPeriodId">
                    @foreach (var period in Model.OpenPayPeriods)
                    {
                        <option value="@period.Id">@period.StartDate - @period.EndDate</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Input.WorkDate">Work date</label>
                <input asp-for="Input.WorkDate" type="date" />
            </div>
            <div class="form-group">
                <label asp-for="Input.HoursWorked">Hours worked</label>
                <input asp-for="Input.HoursWorked" type="number" step="0.25" min="0.25" max="24" />
            </div>
            <button type="submit" class="btn">Submit</button>
        </form>
    }
</div>

<div class="card">
    <h2 style="margin-top:0;font-size:1.1rem;">History</h2>
    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Hours</th>
                <th>Status</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model.Entries)
            {
                <tr>
                    <td>@entry.WorkDate</td>
                    <td>@entry.HoursWorked</td>
                    <td><span class="badge badge-@entry.Status.ToLowerInvariant()">@entry.Status</span></td>
                    <td class="text-muted">@entry.RejectionReason</td>
                </tr>
            }
            @if (!Model.Entries.Any())
            {
                <tr><td colspan="4" class="text-muted">No entries yet.</td></tr>
            }
        </tbody>
    </table>
</div>
